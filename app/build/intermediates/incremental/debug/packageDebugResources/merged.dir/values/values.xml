    <style name="Theme.Catppuccin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/cat_mauve</item>
        <item name="colorOnPrimary">@color/cat_base</item>
        <item name="colorSecondary">@color/cat_mauve</item>
        <item name="colorOnSecondary">@color/cat_base</item>
        <item name="android:colorBackground">@color/cat_base</item>
        <item name="colorSurface">@color/cat_mantle</item>
        <item name="colorOnSurface">@color/cat_text</item>
        <item name="colorError">@color/cat_red</item>
        <item name="colorOnError">@color/cat_base</item>

        
        <item name="android:windowBackground">@color/cat_base</item>
        <item name="android:statusBarColor">@color/cat_mantle</item>
        <item name="android:navigationBarColor">@color/cat_mantle</item>
        <item name="android:windowLightStatusBar">true</item>

        
        <item name="android:textColorPrimary">@color/cat_text</item>
        <item name="android:textColorSecondary">@color/cat_subtext0</item>

        
        <item name="android:fontFamily">@font/montserrat</item>
