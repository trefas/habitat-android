<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="cat_base">#1E1E2E</color>
    <color name="cat_blue">#89B4FA</color>
    <color name="cat_crust">#11111B</color>
    <color name="cat_green">#A6E3A1</color>
    <color name="cat_lavender">#B4BEFE</color>
    <color name="cat_mantle">#181825</color>
    <color name="cat_maroon">#EBA0AC</color>
    <color name="cat_mauve">#CBA6F7</color>
    <color name="cat_overlay0">#6C7086</color>
    <color name="cat_peach">#FAB387</color>
    <color name="cat_pink">#F5C2E7</color>
    <color name="cat_red">#F38BA8</color>
    <color name="cat_sapphire">#74C7EC</color>
    <color name="cat_subtext0">#A6ADC8</color>
    <color name="cat_subtext1">#BAC2DE</color>
    <color name="cat_surface0">#313244</color>
    <color name="cat_surface1">#45475A</color>
    <color name="cat_surface2">#585B70</color>
    <color name="cat_teal">#94E2D5</color>
    <color name="cat_text">#CDD6F4</color>
    <color name="cat_yellow">#F9E2AF</color>
    <style name="Theme.Catppuccin" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/cat_blue</item>
        <item name="colorOnPrimary">@color/cat_base</item>
        <item name="colorSecondary">@color/cat_mauve</item>
        <item name="colorOnSecondary">@color/cat_base</item>
        <item name="android:colorBackground">@color/cat_base</item>
        <item name="colorSurface">@color/cat_mantle</item>
        <item name="colorOnSurface">@color/cat_text</item>
        <item name="colorError">@color/cat_red</item>
        <item name="colorOnError">@color/cat_base</item>

        <item name="android:windowBackground">@color/cat_base</item>
        <item name="android:statusBarColor">@color/cat_mantle</item>
        <item name="android:navigationBarColor">@color/cat_mantle</item>
        <item name="android:windowLightStatusBar">false</item>

        <item name="android:textColorPrimary">@color/cat_text</item>
        <item name="android:textColorSecondary">@color/cat_subtext0</item>

        <item name="android:fontFamily">@font/montserrat</item>
        <item name="fontFamily">@font/montserrat</item>

        <item name="editTextStyle">@style/Widget.Catppuccin.EditText</item>
    </style>
    <style name="Widget.Catppuccin.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:textColor">@color/cat_text</item>
        <item name="android:textColorHint">@color/cat_subtext0</item>
        <item name="android:backgroundTint">@color/cat_surface2</item>
    </style>
</resources>